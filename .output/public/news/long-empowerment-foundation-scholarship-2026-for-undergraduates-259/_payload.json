[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-long-empowerment-foundation-scholarship-2026-for-undergraduates-259":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},259,"long-empowerment-foundation-scholarship-2026-for-undergraduates-259","Long Empowerment Foundation Scholarship 2026 For Undergraduates","\u003Cp>The Long Empowerment Foundation has opened applications for the 2026 LONG Scholars Program for eligible Nigerians.\u003C\u002Fp>\u003Cp>\u003Cstrong>Long Empowerment Foundation Scholarship Abstract\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: Long Empowerment Foundation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fundergraduate-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Undergraduate Scholarships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Living Stipends\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Books\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Learning Materials\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: June 18, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Long Empowerment Foundation Scholarship (LONG Scholars Program) Details\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>Applications are now open for Nigerian students seeking financial support under the \u003Cstrong>Tertiary \u003C\u002Fstrong>\u003Ca class=\"google-anno\" href=\"https:\u002F\u002Fscholarsworld.ng\u002Flong-empowerment-foundation-scholarship\u002F#\">\u003Cstrong> \u003Cu>Education\u003C\u002Fu>\u003C\u002Fstrong>\u003C\u002Fa>\u003Cstrong> Scholarship \u003C\u002Fstrong>category of the LONG Empowerment Foundation Scholars Program.\u003C\u002Fp>\u003Cp>The Long Empowerment Foundation Scholarship provides academic and vocational scholarships, mentorship, and a thriving support community to help youth rise above their circumstances and rewrite their stories.\u003C\u002Fp>\u003Cp>The scholarship is designed to support students from low-income families who have secured admission into accredited Nigerian institutions. Apply now and secure your future!\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>2026 LONG Scholars Program Benefits\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The LONG Scholars Program offers up to ₦350,000 per academic year, renewable based on academic performance and need.\u003C\u002Fp>\u003Cp>The Long Foundation Scholarship covers;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>tuition,\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>exams,\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>accommodation, and\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>learning materials for secondary and tertiary students.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Available Programmes for Long Foundation Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The Long Foundation Scholarships are open to students who have secured admission to pursue; \u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>\u003Cstrong>National Diploma (ND),\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Higher National Diploma (HND), or\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Bachelor’s Degree\u003C\u002Fstrong> programs.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Participating Universities for Long Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>Students from recognized Nigerian tertiary institutions across;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Universities\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Polytechnics\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Colleges of Education\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Long Empowerment Foundation Scholarship 2026 Requirements\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To be eligible for the undergraduate Long Empowerment Foundation Scholarship, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>must be \u003Cstrong>16–26 years old\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>must already have admission or\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>be a continuing student\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>household income must be \u003Cstrong>below ₦3,000,000 per year\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>must provide \u003Cstrong>academic records, proof of financial need, and a reference letter\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Required Documents for LONG Scholars Program 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>While applying for the LONG Scholars Program, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Complete Application Form\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Academic Transcripts\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Reference Letter\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Proof of Financial Need\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>How To Apply for Long Empowerment Foundation Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To apply for the Long Empowerment Foundation Scholarship, follow the instructions we have outlined below; \u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Read the information we have provided on this webpage and ensure your eligibility\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Applications open annually in May\u002FJune for a period of four weeks.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>All applications must be submitted via the online application form during the application window.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Eligible applications are reviewed by our team, and offers are made in late August.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Deadline: June 18th, 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>APPLY HERE: \u003C\u002Fstrong>\u003Ca href=\"https:\u002F\u002Flongempowerment.org\u002Fscholarships\">\u003Cstrong>https:\u002F\u002Flongempowerment.org\u002Fscholarships\u003C\u002Fstrong>\u003C\u002Fa>\u003C\u002Fp>","LINKSKOOL",16,"published",0,"2026-05-23 13:45:39",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Flong-empowerment-foundation-scholarship-2026-for-undergraduates\u002F6a11a1732e4615.48483503_screenshot 2026-05-23 134443.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Flong-empowerment-foundation-scholarship-2026-for-undergraduates\u002F6a11a1732e4615.48483503_screenshot%202026-05-23%20134443.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,37,47,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":9},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33