[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-rev-tony-akinyemi-foundation-scholarship-2026-rtsf-for-nigerians-how-to-apply-135":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},135,"rev-tony-akinyemi-foundation-scholarship-2026-rtsf-for-nigerians-how-to-apply-135","Rev Tony Akinyemi Foundation Scholarship 2026 (rtsf) For Nigerians: How To Apply","\u003Cp>The RTSF Scholarship 2026 offers a full tuition support opportunity for high school and undergraduate students in Nigeria.\u003C\u002Fp>\u003Cp>\u003Cstrong>Rev Tony Akinyemi Foundation Scholarship 2026 Abstract\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: Rev Tony Akinyemi Foundation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fundergraduate-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Undergraduate Scholarships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: May 16, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>About the Rev Tony Akinyemi Foundation Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>Are you a brilliant student facing financial challenges? The Rev. Tony Akinyemi Scholarship Foundation (RTSF) is here to support your dreams.\u003C\u002Fp>\u003Cp>The Tony Akinyemi Foundation Scholarship is committed to providing scholastic opportunities to indigent students, restoring hope, and bringing the light of the gospel to the world.\u003C\u002Fp>\u003Cp>The Tony Akinyemi Scholarship provides scholarships to students who are academically outstanding but financially disadvantaged.\u003C\u002Fp>\u003Cp>\u003Cstrong>Rev Tony Akinyemi Foundation Scholarship 2026 Benefits\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The Rev Tony Akinyemi Foundation Scholarship offers full tuition coverage for Nigerian undergraduates and high school students who are enrolled in any accredited federal or state tertiary institution\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Participating Institutions for Rev Tony Akinyemi Foundation Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>For the 2026 edition of the RTSF Scholarship, students from the following institutions are eligible to apply;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Universities\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Polytechnics\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Colleges\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Secondary Schools\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Rev Tony Akinyemi Foundation Scholarship Requirements\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To be eligible for the undergraduate and Rev Tony Akinyemi Foundation Scholarship, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cp>\u003Cstrong>Undergraduates\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Be an undergraduate Nigerian student from a government institution\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have a minimum GPA of 3.50\u002F5.00 or 2.50\u002F4.00\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be an undergraduate student in 100-300 level (4-year course); 100- 400L (5-year course); 100- 500L (6-year course)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be in need of financial support\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Secondary School Students\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Be a secondary student from a government institution\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have a minimum of 65%\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be a student in JSS1 – SSS 2, or in PRIMARY 6, going to JSS1 in the next session\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be in need of financial support\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Apply Here: \u003Ca href=\"https:\u002F\u002Ftonyakinyemifoundation.com\u002Fapply\u002F\">https:\u002F\u002Ftonyakinyemifoundation.com\u002Fapply\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","LINKSKOOL",16,"published",0,"2026-04-13 16:19:45",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Frev-tony-akinyemi-foundation-scholarship-2026-rtsf-for-nigerians-how-to-apply\u002F69dd0991d11382.00239623_screenshot 2026-04-13 161635.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Frev-tony-akinyemi-foundation-scholarship-2026-rtsf-for-nigerians-how-to-apply\u002F69dd0991d11382.00239623_screenshot%202026-04-13%20161635.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,37,47,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":9},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexp