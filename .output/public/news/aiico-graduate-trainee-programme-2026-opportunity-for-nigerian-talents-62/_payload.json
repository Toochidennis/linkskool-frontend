[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-aiico-graduate-trainee-programme-2026-opportunity-for-nigerian-talents-62":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":27},62,"aiico-graduate-trainee-programme-2026-opportunity-for-nigerian-talents-62","Aiico Graduate Trainee Programme 2026: Opportunity For Nigerian Talents","If so, AIICO Insurance PLC welcomes you to explore the abundant possibilities that await you on your journey towards professional excellence.\n\nAIICO Capital Graduate Trainee Program Abstract\n\n    Host: AIICO Plc\n    Category: Internships \n    Benefits:\n        Monthly Salary\n        Employment\n        Training\n        Networking\n    Eligibility: Nigerian Graduates\n    Deadline: March 16, 2026\n\nAIICO Capital Graduate Trainee Requirements\n\nTo be considered for the AIICO Capital Graduate Trainee Program, you should meet the following criteria:\n\n    BSc (2:1) in Economics, Finance, Accounting, Statistics, Mathematics, Financial Engineering, Business Administration, Computer Science or related fields\n    0 – 2 years of experience upon completion of NYSC\n    Not more than 26 years old as of December 31st, 2026\n    Strong analytical, problem-solving and communication skills\n    Tech-savvy with a data-driven mindset\n    Eager to learn and passionate about investment and financial markets\n\nRequired Skills\n\n    Analytical and Core thinking skills\n    Strong communication and Interpersonal Skills\n    Attention to Details\n    Ethical Integrity\n    A strong understanding to financial markets\n    Strategic and Business Acumen\n    Critical Thinking\n    Problem solving\nAPPLY HERE: https:\u002F\u002Fwp.aiicocapital.com\u002Fjobs\u002Faiico-capital-graduate-trainee\u002F","Ijeoma",16,"published",0,"2026-03-