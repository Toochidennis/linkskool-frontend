[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"news-detail-manaaki-new-zealand-scholarships-2026-opportunities-for-developing-countries-77":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":27},77,"manaaki-new-zealand-scholarships-2026-opportunities-for-developing-countries-77","Manaaki New Zealand Scholarships 2026: Opportunities For Developing Countries","\u003Cp>Manaaki New Zealand Scholarship Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: New Zealand Government\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002F\">Study Abroad\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-australia\u002F\">Study-In-Australia\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fundergraduate-scholarships\u002F\">Undergraduate Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fpostgraduate-scholarships\u002F\">Postgraduate Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fmasters-scholarships\u002F\">Masters Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fphd-scholarships\u002F\">PhD Scholarships\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Living Stipends\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Travel Costs\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Medical Insurance\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Scholarship application assistance\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Developing Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Deadline: March 31, 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Manaaki New Zealand Scholarships Requirements\u003C\u002Fp>\u003Cp>To be eligible for the undergraduate and postgraduate Manaaki New Zealand Scholarships, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Hold citizenship of eligible countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be resident in the home country for at least two prior to applying\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Work experience: Minimum of one year for postgraduate applicants\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Age requirement: 18 years or older, with some exceptions\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Visa requirements: Student visa required\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Academic and English language requirements\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Manaaki New Zealand Scholarships Benefits and Timeline\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>The scholarship covers a range of entitlements, including travel, accommodation, $25,448 living expenses, tuition fees, and insurance.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Visa costs are reimbursed for eligible candidates.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Vaccination against COVID-19 is not mandatory but can be reimbursed.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Selection Criteria\u003C\u002Fp>\u003Cp>Scholars ofthe Manaaki New Zealand Scholarshipsare are chosen based on:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Strong academic ability\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Commitment to the social and economic development of their country\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Age limit: 39 years or younger when the scholarship starts\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Alignment of chosen courses with recommended subjects\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Intention to foster positive relations with New Zealand\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Pursuit of a qualification beyond their highest obtained\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Contribution to the country’s development post-scholarship\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fwww.nzscholarships.govt.nz\u002Finternational-tertiary-students\u002F\">https:\u002F\u002Fwww.nzscholarships.govt.nz\u002Finternational-tertiary-students\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","LINKSKOOL",16,"published",0,"2026-03-13 11:54:44",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmanaaki-new-zealand-scholarships-2026-opportunities-for-developing-countries\u002F69b3ecf4b3d836.66694098_screenshot 2026-03-13 113812.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmanaaki-new-zealand-scholarships-2026-opportunities-for-developing-countries\u002F69b3ecf4b3d836.66694098_screenshot%202026-03-13%20113812.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",1,[29,38,48,58,67,76,85,94,102],{"id":30,"slug":31,"title":32,"images":33,"datePosted":37,"authorName":9},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[34],{"fileName":35,"oldFileName":35,"type":18,"file":19,"url":36},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3