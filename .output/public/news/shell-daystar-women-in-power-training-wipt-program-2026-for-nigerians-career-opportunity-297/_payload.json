-opportunity-295",[106],{"fileName":107,"oldFileName":107,"type":18,"file":19,"url":108},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a32ac1a0044e3.66262713_screenshot 2026-06-17 151101.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a32ac1a0044e3.66262713_screenshot%202026-06-17%20151101.png","2026-06-17 15:15:54",1782337545795]