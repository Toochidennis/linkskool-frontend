[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-coris-bank-young-graduate-program-2026-apply-now-38":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":25},38,"coris-bank-young-graduate-program-2026-apply-now-38","Coris Bank Young Graduate Program 2026 | Apply Now","Are you a young graduate looking for where to build your banking career?\n\nCoris Bank has opened application for 2026 Coris Bank Young Graduate Program.\n\n\nCoris Bank Young Graduate Program Abstract\n\n    Host: Coris Bank\n    Location: Nigeria\n    Category: Trainings\n    Benefits: Full rining\n        Soft Skills\n        Experience\n        Coaching\n        Certifications\n        Training bonus\n        Immersion in fintech and data\n        Employment opportunities\n    Eligibility: All Countries\n    Deadline: March 02, 2026\n\n\nCoris Bank Young Graduate Program Details\n\nThe Coris Young Graduate Program is a strategic program for acquiring and developing high-potential individuals, designed to ensure succession planning and accelerate digital transformation.\n\nThis initiative aims to position Coris Bank International as an employer of choice in each of the markets where it operates.\n\nIt serves as a mechanism for attracting and retaining the brightest minds from top universities and business schools.\n\nThis program is open to recent graduates from all Coris Bank International subsidiaries and branches in Africa.\n\nThe Young Graduate program lasts 12 months and includes training, operational assignments and personalized mentoring. The training program will take place within each subsidiary. Each graduate must apply from their current country of residence where a subsidiary is located.\nCoris Bank Young Graduate Program Benefits\n\nThe Coris Bank Young Graduate Program offers to participants:\n\n    Soft Skills\n    Experience\n    Coaching\n    Certifications\n    Training bonus\n    Immersion in fintech and data\n    Employment opportunities\n\n\nCoris Bank Young Graduate Program Requirements\n\nTo be eligible for theCoris Bank Young Graduate Program, applicants must satisfy the following conditions:Internship listings\n\n    Reside in a country where Coris Bank International is present\n    Be aged thirty (30) years or younger on the closing date of the call for applications.\n    Holder of a Master 2 (Bac+5 minimum) at the date of application.\n    Be available for a practical training program lasting 12 to 24 months.\n\nCoris Bank Young Graduate Program Required Documents\n\nWhile applying for the Coris Bank Young Graduate Program, you will be required to submit the following documents;\n\n    Curriculum Vitae (CV)\n    Master’s Degree Transcripts\n    Proof of successful defense\n    Copy of valid identity document\n\nAPPLY HERE: https:\u002F\u002Fygp.coris-holding.com\u002F","Ijeoma",16,"published",0,"2026-02-28 13:52:14",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fcoris-bank-young-graduate-program-2026-apply-now\u002F69a2e4fe2af252.44465901_gemini_generated_image_xpy6ulxpy6ulxpy6.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fcoris-bank-young-graduate-program-2026-apply-now\u002F69a2e4fe2af252.44465901_gemini_generated_image_xpy6ulxpy6ulxpy6.png","2026-02-28 07:52:14","2026-06-24 11:55:43",[24],{"id":25,"name":26,"createdAt":27},2,"Opportunities","2026-01-07 13:35:07",[29,39,49,59,68,77,86,95,103],{"id":30,"slug":31,"title":32,"images":33,"datePosted":37,"authorName":38},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[34],{"fileName":35,"oldFileName":35,"type":18,"file":19