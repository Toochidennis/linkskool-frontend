[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-nddc-postgraduate-scholarship-2026-for-nigerians-fully-funded-opportunity-102":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},102,"nddc-postgraduate-scholarship-2026-for-nigerians-fully-funded-opportunity-102","Nddc Postgraduate Scholarship 2026 For Nigerians: Fully Funded Opportunity","\u003Cp>The Federal Government of Nigeria is offering fully funded scholarship opportunities through the Federal Ministry of Niger Delta Affairs to eligible Nigerians to study in any foreign universities of their choice.\u003C\u002Fp>\u003Cp>NDDC Postgraduate Scholarship Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: NDDC\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Study Abroad: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002Fstudy-abroad\u002F\">Study Abroad\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-asia\u002F\">Study-In-Asia\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-africa\u002F\">Study-In-Africa\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-canada\u002F\">Study-In-Canada\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-europe\u002F\">Study-In-Europe\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-australia\u002F\">Study-In-UK\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-usa\u002F\">Study-In-USA\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Any Foreign Country\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002F\">Scholarships\u003C\u002Fa> ||  \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fpostgraduate-scholarships\u002F\">Postgraduate Scholarships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Living Stipends\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Visa\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Medical Insurance\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: April 19, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>NDDC Postgraduate Scholarship Details\u003C\u002Fp>\u003Cp>The NDDC Postgraduate Scholarship is an initiative of the Niger Delta Development Cooperation under the sponsorship of the Federal Government of Nigeria.\u003C\u002Fp>\u003Cp>The Niger Delta Development Commission (NDDC) is offering a foreign post graduate scholarship program as part of its human resource development initiatives to give Niger Deltans the training and skills they need to effectively participate in the current administration’s local content program and compete internationally in a variety of professional disciplines.\u003C\u002Fp>\u003Cp>The NDDC Scholarship is for candidates who meet the requirements and have earned relevant Bachelor’s or Master’s degrees from reputable universities.\u003C\u002Fp>\u003Cp>NDDC Postgraduate Scholarship 2026 Benefits\u003C\u002Fp>\u003Cp>Fully Funded Scholarship to study in any of the foreign universities with all expenses of tuition, travel, visa, stipends, and accommodation covered.\u003C\u002Fp>\u003Cp>Eligible Programmes for NDDC Postgraduate Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Agricultural Sciences\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Engineering\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Environmental Sciences\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Geosciences\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Information Technology\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Law\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Management Sciences\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Medicine\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Architecture\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Hospitality Management\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>NDDC Postgraduate Scholarship 2026 Requirements\u003C\u002Fp>\u003Cp>To be eligible for the postgraduate NDDC Postgraduate Scholarship, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Be from the Niger Delta Region\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have completed the mandatory National Youth Service Corps (NYSC)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have First Degree with minimum of 2nd Class-Lower division for those wishing to undertake a Master’s Programme\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Not belong to any cult group and must not have any criminal record\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have gained admission for a Post Graduate Programme in any of the listed disciplines above, in a Foreign University.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Required Documents for NDDC Scholarship\u003C\u002Fp>\u003Cp>While applying for the 2026 NDDC Scholarship, you will be required to submit the following documents;\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Application Form (to be completed online)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Recent passport photograph\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Local Government Identification Letter\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Post Graduate admission letter from a recognized Oversea University. Relevant degrees from recognized Universities.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>WASSCE\u002FNECO results\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>NYSC Discharge\u002FExemption Certificate\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Guarantor’s written consent of good conduct of the applicant from any of the following persons from the applicant’s Community\u002FClan\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Member of National Assembly\u002FState House of Assembly\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Chairman of LGA\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>First Class Traditional ruler\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>High Court Judge\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Apply Here: \u003Ca href=\"https:\u002F\u002Fwww.nddc.gov.ng\u002FWhatWeDo\u002FScholarship\">https:\u002F\u002Fwww.nddc.gov.ng\u002FWhatWeDo\u002FScholarship\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","linkskool",16,"published",0,"2026-03-27 11:02:41",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnddc-postgraduate-scholarship-2026-for-nigerians-fully-funded-opportunity\u002F69c655c157a999.60115418_screenshot 2026-03-27 095145.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnddc-postgraduate-scholarship-2026-for-nigerians-fully-funded-opportunity\u002F69c655c157a999.60115418_screenshot%202026-03-27%20095145.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,47,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u