[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-stanbic-ibtc-graduate-trainee-2026-nigeria-career-opportunity-101":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},101,"stanbic-ibtc-graduate-trainee-2026-nigeria-career-opportunity-101","Stanbic Ibtc Graduate Trainee 2026 Nigeria: Career Opportunity","\u003Cp>Stanbic Graduate Trainee Program: Are you a young, ambitious professional seeking to kickstart your career journey?\u003C\u002Fp>\u003Cp>Stanbic IBTC Group presents an exciting opportunity for young Nigerians through its 2026 Graduate Trainee Program.\u003C\u002Fp>\u003Cp>Stanbic Graduate Trainee Program Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Stanbic IBTC\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002Finternships\u002F\">Internships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Monthly Salary\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Employment\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Deadline: Not Specified\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Stanbic Graduate Trainee Program Details\u003C\u002Fp>\u003Cp>The Stanbic IBTC Graduate Trainee Program is a comprehensive initiative aimed at building a robust talent pipeline within our organization. \u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>The Graduate Trainee Internship Program of Stanbic IBTC Group has been designed to build capacity and create a sustainable pipeline in our group by developing young, talented, trained undergraduates for our future.\u003C\u002Fp>\u003Cp>It is an intensive program and a unique opportunity for undergraduates who are resourceful and passionate about career growth.\u003C\u002Fp>\u003Cp>As a participant, you will embark on a journey of learning and growth, working alongside seasoned professionals and gaining exposure to diverse business functions.\u003C\u002Fp>\u003Cp>By joining her dynamic team, you will have the opportunity to grow, learn, and contribute to our collective success.\u003C\u002Fp>\u003Cp>Stanbic Graduate Trainee Program Benefits\u003C\u002Fp>\u003Cp>If you are selected for the Stanbic Graduate Trainee Program, you will enjoy;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>competitive Monthly Salary\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Paid Leaves\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Health Benefits\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Employment Opportunities\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Career Development\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Stanbic Graduate Trainee Program Requirements\u003C\u002Fp>\u003Cp>To be eligible for the Stanbic Graduate Trainee Program, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cp>\u003Cstrong>African scholarships guide\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Preferred Qualification and Experience:\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Minimum of a Second Class Upper (or its equivalent) degree in any course from an accredited University.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Minimum of 5 credits (Mathematics and English inclusive) in GCE, NECO or its equivalent.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Applicants should not be more than 26 years of age as at engagement.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Applicants must have concluded National Youth Service Corps (NYSC) programme and have discharge certificate in hand.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Applicant’s Date of Birth, Gender and Class of degree must be clearly stated\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>APPLY HERE:\u003Ca href=\"https:\u002F\u002Fwww.standardbank.com\u002Fsbg\u002Fstandard-bank-group\u002Fcareers\u002Fapply\u002Fjobs\u002Fview-all-jobs\u002Fjob-detail?jobID=744000116172170&amp;utm_source=ScholarsWorld\">https:\u002F\u002Fwww.standardbank.com\u002Fsbg\u002Fstandard-bank-group\u002Fcareers\u002Fapply\u002Fjobs\u002Fview-all-jobs\u002Fjob-detail?jobID=744000116172170&amp;utm_source=ScholarsWorld\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Linkskool",16,"published",0,"2026-03-25 10:38:28",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fstanbic-ibtc-graduate-trainee-2026-nigeria-career-opportunity\u002F69c3ad14f127f5.56520100_screenshot 2026-03-25 103055.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fstanbic-ibtc-graduate-trainee-2026-nigeria-career-opportunity\u002F69c3ad14f127f5.56520100_screenshot%202026-03-25%20103055.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully