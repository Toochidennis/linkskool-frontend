[{"data":1,"prerenderedAt":113},["ShallowReactive",2],{"news-detail-oregon-institute-of-technology-scholarship-in-united-states-2026-9":3},{"news":4,"more":29},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":28},9,"oregon-institute-of-technology-scholarship-in-united-states-2026-9","Oregon Institute Of Technology Scholarship In United States 2026","The Oregon Institute of Technology Scholarship provides a $15,000 stipend per year, including $7,000 in tuition remission for applicants who meet the application criteria and are selected for the opportunity.\nOregon Institute of Technology Scholarship Summary\nHost Country: USA\nStudy Abroad: Study in USA \nCategory: Postgraduate Scholarships | Masters Scholarships \nEligible Countries: All Countries\nReward: Full Scholarship | $15,000 Stipend\u002FYear\nNo IELTS Required \nDeadline: March 31, 2026\n\nHow to Apply for Oregon Institute of Technology Scholarship (Step by Step)\n\nTo apply for the Oregon Institute of Technology Scholarship, interested and qualified candidates should;\n\nSend one PDF file containing a cover letter, curriculum vitae, transcripts, and the names and contact information of three references to:\nDr. Bing Yuan (Assistant Professor, Oregon Institute of Technology)\nEmail: bing.yuan@oit.edu\nApplications will be reviewed on a rolling basis, with the position closing on March 31, 2026. The anticipated start date is September 2026.","Ijeoma",16,"published",0,"2026-02-13 09:27:04",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002F698ee0586c8ea8.03379693_screenshot 2026-02-13 092020.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002F698ee0586c8ea8.03379693_screenshot%202026-02-13%20092020.png","2026-02-13 03:27:04","2026-06-24 11: