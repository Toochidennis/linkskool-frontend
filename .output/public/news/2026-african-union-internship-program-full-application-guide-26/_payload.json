[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-2026-african-union-internship-program-full-application-guide-26":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":25},26,"2026-african-union-internship-program-full-application-guide-26","2026 African Union Internship Program: Full Application Guide","The 2026 African Union Internship Program offers a unique opportunity for students to gain professional experience at its Headquarters located at Addis Ababa, Ethiopia. \n\nThe African Union Internship Program provides an opportunity for interns to complement their educational experience and to develop their professional skills and experience\n\n\nAfrican Union Internship Abstract\n\n    Scholarship Host: African Development Bank \n    Location: Addis Ababa\n    Category: Internships || Trainings\n    Benefits:\n        Training\n        Travel Costs\n        Health Benefits\n    Eligibility: All Countries\n    Deadline: December 31, 2026\n\n\n026 African Union Internship Requirements\n\nTo be eligible for the 2026 African Union Internship, applicants must satisfy the following conditions:\n\n    Actively enrolled in at least the final year of a Bachelor’s degree program OR\n    Must have obtained a Bachelor’s degree or an advanced\u002F postgraduate (Master’s) qualification in a related academic field; \n    Be nationals of a Member State of the African Union.\n    Be full-time students currently enrolled in the final year of their Bachelor’s or graduate school program.\n    Be fluent in at least one of the African Union working languages (Arabic, English, French or Portuguese).\n    Be no more than thirty-two (32) years of age at the time of selection.\n    Possess the highest standard of moral conduct and integrity.\n    Have not been convicted of any serious criminal offence excluding minor traffic offences.  \n    Prior work experience is not required for the internship positions.\n\n\nRequired Documents for 2026 African Union Internship\n\nWhile applying for the 2026 African Union Internship, you will be required to submit the following documents;\n\n    Complete Application Form\n    A motivation letter indicating what you expect to gain out of the internship program\n    A copy of valid passport or national identity card\n    Certified copies of relevant academic certificates\n    Current curriculum vitae (CV)\n    Recommendation letter for internship from the institution of learning that they are attending\n    Upon successful submission of their application, applicants will receive an email confirmation that their application has been successfully received.\n\nAPPLY HERE: https:\u002F\u002Fjobs.au.int\u002Fjob\u002FInternship-Program\u002F1506-en_US","Ijeoma",16,"published",0,"2026-02-21 12:01:31",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002F2026-african-union-internship-program-full-application-guide\u002F6999908b70cd09.88103176_screenshot 2026-02-21 115548.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002F2026-african-union-internship-program-full-application-guide\u002F6999908b70cd09.88103176_screenshot%202026-02-21%20115548.png","2026-02-21 06:01:31","2026-06-24 11:55:43",[24],{"id":25,"name":26,"createdAt":27},2,"Opportunities","2026-01-07 13:35:07",[29,39,49,59,68,77,86,95,103],{"id":30,"slug":31,"title":32,"images":33,"datePosted":37,"authorName":38},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[34],{"fileName":35,"oldFileName":35,"type":18,"file":19,"url":36},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-schol