[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-ptdf-overseas-scholarship-2026-in-uk-france-germany-malaysia-for-nigerians-fully-funded--30":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":25},30,"ptdf-overseas-scholarship-2026-in-uk-france-germany-malaysia-for-nigerians-fully-funded--30","Ptdf Overseas Scholarship 2026 In Uk, France, Germany, Malaysia For Nigerians (fully Funded)","PTDF Overseas Scholarship Scheme 2026\u002F27 Details\n\nThe Petroleum Technology Development Fund (PTDF) is pleased to bring to the notice of the public that the applications for the 2025\u002F2026 Overseas Postgraduate Scholarship Scheme(OSS) have commenced.\n\nThe PTDF Overseas Scholarship Scheme is strategically designed to cultivate indigenous talent for the Nigerian Oil and Gas Industry and has been recently restructured to further promote the domestication of capacity development within Nigeria.\n\nThe scheme was developed to offer candidates the opportunity to benefit from a diversified pool of knowledge and the facilities offered by world-class institutions across the globe. Under it, candidates are invited to apply through PTDF to specific programmes at partner institutions.\nPTDF Scholarship 2026 Requirements\n\nTo be eligible for the postgraduate PTDF Scholarship 2026, applicants must satisfy the following conditions:\n\n    Requirements for MSc Candidates:\n        Minimum Second Class Upper (2.1) qualification in the first degree.\n        Completion of the National Youth Service Corps (NYSC).\n        Computer literacy and possession of 5 O\u002Flevel credits, including English and Mathematics.\n        Submission of a statement of purpose (maximum 500 words) outlining the proposed study’s relevance to the industry and national development.\n\n    Requirements for PhD Candidates:\n        Completion of the mandatory NYSC.\n        Computer literacy and possession of 5 O\u002Flevel credits, including English and Mathematics.\n        Minimum Second Class Lower (2.2) in the first degree and a good post-graduate degree.\n        Submission of a research proposal relevant to the oil and gas industry.\n    Fully funded MSc scholarship will be provided in the United Kingdom, Germany, France, and Malaysia.\n    Fully funded PhD scholarship will be provided in Germany, France &amp; Malaysia.\n    Fully funded PhD scholarship for the United Kingdom will now be offered exclusively as a Split-Site Programme at the PTDF College of Petroleum &amp; Energy Studies, Kaduna (CPESK) in collaboration with three partner Universities in the United Kingdom:\n        Robert Gordon University,\n        University of Strathclyde and\n        University of Portsmouth.  \n\n\nPTDF Scholarship 2026 Benefits and Timeline\n\nSuccessful applicants of the PTDF Scholarship will enjoy a comprehensive package, including\n\n    flight tickets,\n    health insurance,\n    accommodation\n    tuition fees, and\n    living allowances.\n  \n\nAPPLY HERE: https:\u002F\u002Fscholarship.ptdf.gov.ng\u002Fguidelines","Ijeoma",16,"published",0,"2026-02-23 11:42:31",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fptdf-overseas-scholarship-2026-in-uk-france-germany-malaysia-for-nigerians-fully-funded\u002F699c2f178dffa3.13816550_screenshot 2026-02-23 113541.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fptdf-overseas-scholarship-2026-in-uk-france-germany-malaysia-for-nigerians-fully-funded\u002F699c2f178dffa3.13816550_screenshot%202026-02-23%20113541.png","2026-02-23 05:42:31","2026-06-24 11:55:43",[24],{"id":25,"name":26,"createdAt":27},2,"Opportunities","2026-01-07 13:35:07",[29,39,49,59,68,77,86,95,103],{"id":30