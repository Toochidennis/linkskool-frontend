[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-selar-tuition-fund-2026-smart-hustle-initiative-for-undergraduate-amp-high-school-students-40":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":25},40,"selar-tuition-fund-2026-smart-hustle-initiative-for-undergraduate-amp-high-school-students-40","Selar Tuition Fund 2026 (smart Hustle Initiative) For Undergraduate &amp; High School Students","Selar Tuition Fund Abstract\n\n    Scholarship Host: Selar Tuition Fund\n    Category: Scholarships || Nigerian Scholarships || High School Scholarships || Undergraduate Scholarships \n    Benefits: \n        ₦100,000 for Undergraduates\n        ₦50,000 for Sec. Sch. Students\n    Eligibility: Nigeria\n    Deadline: March 13, 2026\n\nClick HERE To receive more daily scholarship updates from Scholars World.Internship listings\nSelar Tuition Fund (Smart Hustle Initiative) 2026\n\nAs part of the Selar Smart Hustle initiative, applications for the 2026 Selar Tuition Fund are now open.\n\nThis is Selar’s social impact and CSR arm, focused on tackling fraud at its roots by expanding access to education and opportunities for the youth, and fostering belief in legitimate pathways to success.\n\nThrough the Selar Smart Hustle Initiative 2026, the company is committing ₦10,000,000 to support Nigerian students at critical points in their educational journey: Secondary school students who are writing the WAEC &amp; JAMB exams, and University\u002FPolytechnic students in their final year.\n\n\nSelar Smart Hustle Initiative 2026 Requirements\n\nTo be eligible for the Selar Smart Hustle Initiative 2026, applicants must satisfy the following conditions:\n\nUNIVERSITY\u002F POLYTECHNIC\n\n    Be a student living and studying in Nigeria.\n    Be a final year student enrolled in an accredited tertiary institution (public, private, polytechnic)\n    Provide a clear statement of purpose (Video format)\n    Have a CGPA of 3.0\u002FCumulative grade of 65% or higher with academic records as an attestation\n    Have a financial or economic need.\n    Provide a valid student ID card\n    Provide the most recent transcript\n\nSECONDARY SCHOOL (SS3)\n    Proof of SS3 status: 1st term school results\n    Evidence of registration for WAEC\u002FJAMB\n    Video application\n\n\nSelar Tuition Fund Benefits and Timeline\n\nThe Selar Tuition Fund is a ₦10,000,000 Total Commitment. The scholarship will be disbursed at the rate of;\n\n    ₦100,000 per student for 50 Final Year Tertiary Students\n    ₦50,000 per student to 100 SS3 Students\n\n\nRequired Documents for Selar Smart Hustle Initiative 2026\n\nWhile applying for the Selar Smart Hustle Initiative 2026, you will be required to submit the following documents;Study abroad programs\n\n    Complete Application Form\n    Academic Transcripts\n    Personal Statement (Video Format)\n    Student ID Card\n    WAEC\u002FJAMB Registration (Secondary School Students)\n\n\n\n\n\nAPPLY HERE: https:\u002F\u002Fevents.selar.com\u002Fpage\u002Fselarsmarthustle","Ijeoma",16,"published",0,"2026-03-02 09:34:17",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fselar-tuition-fund-2026-smart-hustle-initiative-for-undergraduate-amp-high-school-students\u002F69a54b89883c20.94725005_screenshot 2026-03-02 092619.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fselar-tuition-fund-2026-smart-hustle-initiative-for-undergraduate-amp-high-school-students\u002F69a54b89883c20.94725005_screenshot%202026-03-02%20092619.png","2026-03-02 03:34:17","2026-06-24 11:55:43",[24],{"id":25,"name":26,"createdAt":27},2,"Opportunities","2026-01-07 13:35:07",[29,39,49,59,68,77,86,95,103],{"id":30,"slug":3