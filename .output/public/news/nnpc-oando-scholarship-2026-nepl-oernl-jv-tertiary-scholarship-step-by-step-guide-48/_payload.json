[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"news-detail-nnpc-oando-scholarship-2026-nepl-oernl-jv-tertiary-scholarship-step-by-step-guide-48":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},48,"nnpc-oando-scholarship-2026-nepl-oernl-jv-tertiary-scholarship-step-by-step-guide-48","Nnpc\u002Foando Scholarship 2026 (nepl\u002Foernl Jv Tertiary Scholarship): Step-by-step Guide","NNPC\u002FOANDO Scholarship Abstract\n\n1Scholarship Host: NNPC\u002FOANDO Energy Resources Nigeria Limited (OERNL)Internship listings\n\n    Category: Scholarships || Nigerian Scholarships || Undergraduate Scholarships\n    Benefits: ₦200,000\u002FYr\n    Eligibility: Nigeria\n    Deadline: April 1, 2026\n\n\nNNPC OANDO Scholarship Requirements\n\nThe requirements candidates must satisfy to be eligible for the NNPC\u002FOANDO Scholarship are as follows;\n\n    NATIONAL MERIT AWARD (NM)\n\nOpen to all Nigerians.Internship listings\n\n    AREAS OF OPERATION MERIT AWARD\n\nOpen Nigerians who are indigenes of Beyelsa, Delta, Imo, and Rivers States.\n\nThe following criteria for eligibility are the general requirements for all candidates;\n\n    Must be citizens of the Federal Republic of Nigeria\n    Must be registered FULL TIME undergraduates in an accredited and approved University in Nigeria\n    Must be in 100 Level or possess proof of admission into Undergraduate programme  in the current academic session.\n    Must not be a beneficiary of any other scholarship from an entity operating in the Oil and Gas Industry, National or International\n\n\nNNPC\u002FOANDO Scholarship Amount\n\n    The NNPC\u002FOANDO Scholarship is a ₦200,000.00 annual award to all successful scholars and winners of the scholarship.\n    The NEPL\u002FOERNL JV Tertiary Scholarship is renewable on an annual basis for all candidates who meet the minimum required CGPA\n\n\nRequired Documents for NNPC OANDO Scholarship 2026\n\nWhile applying for the NNPC\u002FOANDO Scholarship 2026, you will be required to submit the following documents;\n\n    Passport photograph with white background, not more than 6 months old (450px by 450px, not more than 200kb)\n    School ID Card\n    O’level Certificate\n    Admission Letter\n    Birth Certificate\n    Proof of Local Government Area of Origin\n    Letter from Community Paramount Ruler (Only Applicants for Host Communities Merit Award)\n    Letter from CDC Chairman (Only Applicants for Host Communities Merit Award).\n    JAMB Result\n\nAAPLY HERE: https:\u002F\u002Fcandidate.scholastica.ng\u002Fschemes\u002Foandoscholarship2026","Ijeoma",11,"published",0,"2026-03-04 10:12:12",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-oando-scholarship-2026-nepl-oernl-jv-tertiary-scholarship-step-by-step-guide\u002F69a7f76c618f09.65400139_screenshot 2026-03-04 100427.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-oando-scholarship-2026-nepl-oernl-jv-tertiary-scholarship-step-by-step-guide\u002F69a7f76c618f09.65400139_screenshot%202026-03-04%20100427.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,58,67,76,85,94,102],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskoo