[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-airtel-3mtt-nextgen-fellowship-program-for-nigerians-2026-how-to-apply-85":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},85,"airtel-3mtt-nextgen-fellowship-program-for-nigerians-2026-how-to-apply-85","Airtel 3mtt Nextgen Fellowship Program For Nigerians 2026: How To Apply","\u003Cp>Airtel Nigeria, in partnership with the National Information Technology Development Agency (NITDA) is inviting applications for the 2026 NextGen Fellowship Program.\u003C\u002Fp>\u003Cp>irtel-3MTT NextGen Fellowship Program Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Airtel | NITDA \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Online\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Ffellowships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Fellowships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Ftrainings\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Trainings\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Sponsorship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Digital Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Funding\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Certification\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Externship &amp; Job Placement Support\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Expert Mentorship\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: Not Specified\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Airtel 3MTT NextGen Fellowship Program Details\u003C\u002Fp>\u003Cp>Applications are now open for the 2026 Airtel–3MTT NextGen Fellowship.\u003C\u002Fp>\u003Cp>The NextGen Fellowship is a special track under the 3 Million Technical Talent (3MTT) programme, powered by the Airtel Africa Foundation.\u003C\u002Fp>\u003Cp>It spotlights exceptional young Nigerians and equips them with digital skills, mentorship, and real-world experiences that turn learning into lasting opportunity.\u003C\u002Fp>\u003Cp>Built on Airtel’s ₦1 billion digital inclusion commitment, the Fellowship supports 3MTT’s mission to grow a future-ready workforce for Nigeria.\u003C\u002Fp>\u003Cp>2026 Airtel–3MTT NextGen Fellowship Benefits\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Project-based Learnings &amp; Hackathons\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Mentorship from Airtel &amp; 3MTT Experts\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Externship &amp; Job Placement Support\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>National Innovation ChallengesCertificates &amp; Digital Badges\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>The 3MTT Program offers the following benefits;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Free, High-Quality Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Mentorship from top professionals\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Hands-on project experience\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>National tech community access\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Real career pathways\u003Cbr \u002F>Available Programmes for Airtel 3MTT NextGen Fellowship Program 2026\u003C\u002Fp>\u003Cp>Participants receive training across multiple high-demand digital fields, including;\u003C\u002Fp>\u003Cp>\u003Cstrong>Scholarship application guide\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Software development\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Data science and analytics\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>UI\u002FUX design\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Cybersecurity\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Cloud computing\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Product management\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Artificial intelligence and machine learning\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Airtel 3MTT NextGen Fellowship Program Requirements\u003C\u002Fp>\u003Cp>To be eligible for the Airtel–3MTT NextGen Fellowship Program, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Must be a young Nigerian eager to build a digital or technical career\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Must have interest in software, data, cybersecurity, UI\u002FUX, cloud, product management, or AI\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Must be committed to completing the fellowship learning journey\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Must be willing to participate in projects, hackathons and group collaborations\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Ideal for learners, job seekers, creators, innovators and those transitioning into tech\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Ca href=\"https:\u002F\u002Fnextgen.3mttnigeria.com\u002F\">APPLY HERE: https:\u002F\u002Fnextgen.3mttnigeria.com\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Linkskool",16,"published",0,"2026-03-21 12:38:23",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fairtel-3mtt-nextgen-fellowship-program-for-nigerians-2026-how-to-apply\u002F69be832f713ee1.41626017_screenshot 2026-03-21 123254.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fairtel-3mtt-nextgen-fellowship-program-for-nigerians-2026-how-to-apply\u002F69be832f713ee1.41626017_screenshot%202026-03-21%20123254.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07"