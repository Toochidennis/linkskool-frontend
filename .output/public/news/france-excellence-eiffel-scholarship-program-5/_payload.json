[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-france-excellence-eiffel-scholarship-program-5":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":25},5,"france-excellence-eiffel-scholarship-program-5","France Excellence Eiffel Scholarship Program","Call for application 2026 is open.\n\nThe Eiffel Excellence Scholarship Program was established by the French Ministry for Europe and Foreign Affairs to enable French higher education institutions to attract top foreign students to enroll in their masters and PhD programs.\n\nIt gives opportunity to the future foreign decision-makers of the private and public sectors, in priority areas of study, and encourages applicants from foreign countries up to 29 years old at master’s level, and applicants up to 35 years old at PhD level.\n\n2026 Campaign Timeline\nOpening of the call for applications: October 1, 2025\nDeadline for the reception of applications by Campus France:  January 8, 2026 included.\nPublication of results: from the 30th of March, 2026\n.\nRegulations\nEiffel Programme rules – 2026 Session \nOnly applications submitted by French higher education institutions are accepted.\n\nYou are an institution and you have already participated in the Eiffel program =&gt; You should have received an email concerning the access of application files. If that is not the case, please contact us.\nYou are an institution participating for the first time in the Eiffel Program =&gt; Please Contact us in order download the application files.\nYou are a student interested in participating in the Eiffel program : click here\n \n\nContact\nCampus France - Programme France Excellence Eiffel\n28 rue de la Grange-aux-Belles\n75010 Paris\nContact us","Ijeoma",16,"published",0,"2026-02-11 14:27:00",null,[16],{"fileName":17