[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-king-fahd-university-scholarship-kfupm-2026-in-saudi-arabia-fully-funded-opportunity-123":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},123,"king-fahd-university-scholarship-kfupm-2026-in-saudi-arabia-fully-funded-opportunity-123","King Fahd University Scholarship (kfupm) 2026 In Saudi Arabia: Fully Funded Opportunity","\u003Cp>Applications are now being accepted from all qualified and interested international students for the 2026 Fully funded King Fahd University Scholarship at both undergraduate and postgraduate levels.\u003C\u002Fp>\u003Cp>2026 King Fahd University Scholarship Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host Country: Saudi Arabia\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002F\">Study Abroad\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002Fscholarships-in-asia\u002F\">Study-In-Asia\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fpostgraduate-scholarships\u002F\">Postgraduate Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fmasters-scholarships\u002F\">Masters Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fphd-scholarships\u002F\">PhD Scholarships\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Living Stipends\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Visa\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Medical Insurance\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Deadline: April 26, 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>2026 KFUPM Scholarship Requirements\u003C\u002Fp>\u003Cp>To be considered for the 2026 KFUPM Scholarship, candidates must meet the following requirements:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Hold a four-year Bachelor’s Degree in engineering or \u003Ca class=\"google-anno\" href=\"https:\u002F\u002Fscholarsworld.ng\u002Fking-fahd-university-scholarship-kfupm\u002F#\"> \u003Cu>science\u003C\u002Fu>\u003C\u002Fa> from a recognized institution with a major in the proposed field or evidence of a suitable background.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Maintain a Grade-Point Average (GPA) of 3.00 or higher on a scale of 4.00 or equivalent (For Scholarship Students).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Attain a Grade-Point Average (GPA) of 2.50 or higher on a scale of 4.00 or equivalent (For Non-Scholarship Applicants).\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>King Fahd University Scholarship Benefits and Timeline\u003C\u002Fp>\u003Cp>The King Fahd University Scholarship will provide:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Full tuition fees\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Monthly stipend for living expenses\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Airfare ticket\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Textbooks and meals\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Additionally, qualified candidates will have the opportunity to participate in university faculty research and book writing, with funded projects.\u003C\u002Fp>\u003Cp>Required Documents for King Fahd University Scholarship\u003C\u002Fp>\u003Cp>While applying for the 2026 King Fahd University Scholarship, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Copy of identification (National ID for Saudi nationals\u002FPassport for applicants outside Saudi Arabia\u002FIqama for residents of KSA).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Complete official transcripts (For Ph.D. Applicants – MS &amp; BS Transcript\u002FFor Master Applicants – BS Transcript).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Two recommendation letters from academic referees.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Statement-of-Purpose (not exceeding one page).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Passport-size photo with a white background (Optional for females).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>CV detailing education and work experience.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cem>Documents for online application (TOEFL, IELTS, GMAT) are not mandatory but required before final admission.\u003C\u002Fem>\u003C\u002Fp>\u003Cp>\u003Cem>APPLY HERE: \u003C\u002Fem>\u003Ca href=\"https:\u002F\u002Fcgis.kfupm.edu.sa\u002F\">\u003Cem>https:\u002F\u002Fcgis.kfupm.edu.sa\u002F\u003C\u002Fem>\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","linkskool",16,"published",0,"2026-04-08 13:45:54",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fking-fahd-university-scholarship-kfupm-2026-in-saudi-arabia-fully-funded-opportunity\u002F69d64e0270eec7.96324941_screenshot 2026-04-08 133249.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fking-fahd-university-scholarship-kfupm-2026-in-saudi-arabia-fully-funded-opportunity\u002F69d64e0270eec7.96324941_screenshot%202026-04-08%20133249.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,47,57,66,75,84,93,101]