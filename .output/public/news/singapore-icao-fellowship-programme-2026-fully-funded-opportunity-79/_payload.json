[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-singapore-icao-fellowship-programme-2026-fully-funded-opportunity-79":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":27},79,"singapore-icao-fellowship-programme-2026-fully-funded-opportunity-79","Singapore Icao Fellowship Programme 2026 | Fully Funded Opportunity","\u003Cp>The ICAO Fellowship provides Fellowships and Scholarships to government officials from eligible developing ICAO Member States to attend specialised training programmes in Singapore.\u003C\u002Fp>\u003Cp>Singapore ICAO Fellowship Programme Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: Singaporean Government\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Singapore\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002Fcompetitions\u002F\">Fellowships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Sponsorship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Accommodation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Living Stipends\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Travel Costs\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Tourist Destinations\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Deadline: November 08, 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>Shanghai Government Scholarships Requirements\u003C\u002Fp>\u003Cp>To be considered for the Singapore ICAO Fellowship, you must be a government official:\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>who have received endorsement\u002Fnomination by your Director-General of Civil Aviation or equivalent.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>whose job qualifications\u002Fwork portfolios must be relevant to the course applied for.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Organisations should nominate only one applicant per course due to limited fellowships available.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Required Documents\u003C\u002Fp>\u003Cp>While applying for the 2026 Singapore ICAO Fellowship Programme, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Nomination form endorsed by your direct reporting officer (Part 1) and the Director-General of Civil Aviation or equivalent (Part 2). A copy of\u003Cbr \u002F>the nomination form can be found here.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Passport-sized photograph\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Biodata page of your passport\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fwww.caas.gov.sg\u002Fdocs\u002Fdefault-source\u002Fdocs---saa\u002Fdctp-terms-of-award.pdf\">https:\u002F\u002Fwww.caas.gov.sg\u002Fdocs\u002Fdefault-source\u002Fdocs---saa\u002Fdctp-terms-of-award.pdf\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Ijeoma",16,"published",0,"2026-03-16 10:08:36",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fsingapore-icao-fellowship-programme-2026-fully-funded-opportunity\u002F69b7c894d73bc3.27576644_screenshot 2026-03-16 095919.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fsingapore-icao-fellowship-programme-2026-fully-funded-opportunity\u002F69b7c894d73bc3.27576644_screenshot%202026-03-16%20095919.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,