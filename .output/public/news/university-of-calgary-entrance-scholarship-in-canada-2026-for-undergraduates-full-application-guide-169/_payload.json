[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-university-of-calgary-entrance-scholarship-in-canada-2026-for-undergraduates-full-application-guide-169":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},169,"university-of-calgary-entrance-scholarship-in-canada-2026-for-undergraduates-full-application-guide-169","University Of Calgary Entrance Scholarship In Canada 2026 For Undergraduates: Full Application Guide","\u003Cp>University of Calgary Entrance Scholarships: Are you interested in a funded scholarship opportunity in Canada?\u003C\u002Fp>\u003Cp>The University of Calgary is inviting suitably qualified prospective undergraduates to apply for her international entrance scholarships.\u003C\u002Fp>\u003Cp>University of Calgary Entrance Scholarships Details\u003C\u002Fp>\u003Cp>The University of Calgary Entrance Scholarship is offered annually to undergraduate international students entering first year in any undergraduate degree in the upcoming fall term who have satisfied the university’s English Language Proficiency requirement.\u003C\u002Fp>\u003Cp>The scholarship is renewable in the second, third, and fourth year at the University of Calgary, provided recipients achieve a GPA of 2.60 or more over a minimum of 24.00 units in the previous fall and winter terms and continue to pay an international differential tuition fee as an international student.\u003C\u002Fp>\u003Cp>University of Calgary Undergrduate Scholarship Benefits\u003C\u002Fp>\u003Cp>The scholarship is $20,000 per year, renewable in the second, third, and fourth year at the University of Calgary.\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>University of Calgary Undergrduate Scholarship Requirements\u003C\u002Fp>\u003Cp>To be eligible for the University of Calgary Undergraduate Scholarship, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>be international students who are registered full-time in an undergraduate degree program that commences in the Fall term.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>be new students.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>must normally present a minimum GPA of 3.20.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>have satisfied the university’s English Language Proficiency requirement.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>be international students who are required to pay a differential fee and who are not Canadian citizens or Permanent Residents of Canada.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>How To Apply for University of Calgary Scholarship\u003C\u002Fp>\u003Cp>To apply for the University of Calgary Undergraduate Scholarship follow the instructions we have outlined below;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Read the information we have provided on this webpage and ensure your eligibility\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Click on the button below to visit the scholarship webpage\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>You must first apply for \u003Ca class=\"wpel-icon-right\" href=\"https:\u002F\u002Fucalgary.ca\u002Fregistrar\u002Ffinances\u002Fawards-scholarships-and-bursaries\u002Fentrance?_gl=1*liahxw*_ga*MjA3MzgzNDU2NC4xNzI0MTQyNTY5*_ga_Q9BHJZ8QG1*MTcyNDE0MjU3Ny4xLjEuMTcyNDE0NDM3MC4wLjAuMA..*_ga_8LB16FQ08V*MTcyNDE0MjU3Ny4xLjEuMTcyNDE0NDM3MC4wLjAuMA..\">admission\u003C\u002Fa>. You will be given access to the award application 24 to 48 hours after you have submitted your application for admission.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fwww.ucalgary.ca\u002Fregistrar\u002Fawards\u002Funiversity-calgary-international-entrance-scholarship\">https:\u002F\u002Fwww.ucalgary.ca\u002Fregistrar\u002Fawards\u002Funiversity-calgary-international-entrance-scholarship\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Linkskool",16,"published",0,"2026-04-22 10:29:53",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Funiversity-of-calgary-entrance-scholarship-in-canada-2026-for-undergraduates-full-application-guide\u002F69e895119714e6.84825926_screenshot 2026-04-22 102515.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Funiversity-of-calgary-entrance-scholarship-in-canada-2026-for-undergraduates-full-application-guide\u002F69e895119714e6.84825926_screenshot%202026-04-22%20102515.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19","LINKSKOOL",{"id":39,"slug":40,"title":41,"images":42,"datePosted":46,"authorName":47},304,"mexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity","Mexican Government Scholarship For Foreigners 2026: Fully Funded Opportunity",[43],{"fileName":44,"oldFileName":44,"type":18,"file":19,"url":45},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity\u002F6a3c32