[{"data":1,"prerenderedAt":116},["ShallowReactive",2],{"news-detail-nnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity-29":3},{"news":4,"more":32},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":24,"updatedAt":25,"categories":26,"readTime":31},29,"nnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity-29","Nnpc Seplat Scholarship 2026 For Nigerian Students: ₦200,000 Annual Opportunity","The Nigerian National Petroleum Commission (NNPC) and Seplat Energy Plc have announced the commencement of the 2026 Joint Venture National Scholarship Programme. \n\nNNPC Seplat Energy Scholarship Abstract\n\n    Scholarship Host: NNPC\u002FSeplat Energy\n    Category: Scholarships || Nigerian Scholarships || Undergraduate Scholarships\n    Benefits:\n        ₦200,000 per year\n    Eligibility: Nigeria\n    Application Opens: February 23, 2026\n    Deadline: March 13, 2026\n\nClick HERE To receive more daily scholarship updates from Scholars World.\nAbout NNPC Seplat Scholarship 2026\n\nThe NNPC Seplat Undergraduate Scholarship is a laudable initiative jointly undertaken by the Nigerian National Petroleum Commission (NNPC) and Seplat Petroleum Development Company.\n\nThe NNPC Seplat JV Scholarship program aims to provide financial support to deserving Nigerian undergraduate students pursuing higher  education.Education\n\nThe SEPLAT JV Scholarship Scheme is one of Seplat’s  educational Corporate Social Investment programmes and is designed to promote educational development and human capacity building through provision of yearly grants to successful applicants to complete their degree programmes.\nSeplat Energy Scholarship 2026 Amount\n\n    Beneficiaries of the 2026 NNPC Seplat Scholarship will receive financial support of ₦200,000.00, renewable every year.\n    The scholarship goes beyond financial assistance, emphasizing empowerment and access to quality education.\n\nApply Here:  https:\u002F\u002Fforms.zohopublic.com\u002Fseplatteachersempowermentprogr\u002Fform\u002FSeplatScholarship20242025\u002Fformperma\u002FtGPZNxua9UJCF2WdflN9Mn_5V9kQ4waMfmSTf92YBVk","Ijeoma",16,"published",0,"2026-02-23 11:14:38",null,[16,21],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity\u002F699c288e059742.47334046_screenshot 2026-02-23 110050.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity\u002F699c288e059742.47334046_screenshot%202026-02-23%20110050.png",{"fileName":22,"oldFileName":22,"type":18,"file":19,"url":23},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity\u002F699c288e0e6928.83582549_grok-image-c5a4d2c8-68a7-4728-b37e-f7c86dd22aaf.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fnnpc-seplat-scholarship-2026-for-nigerian-students-200-000-annual-opportunity\u002F699c288e0e6928.83582549_grok-image-c5a4d2c8-68a7-4728-b37e-f7c86dd22aaf.png","2026-02-23 05:14:38","2026-06-24 11:55:43",[27],{"id":28,"name":29,"createdAt":30},2,"Opportunities","2026-01-07 13:35:07",1,[33,43,53,63,72,81,90,99,107],{"id":34,"slug":35,"title":36,"images":37,"datePosted":41,"authorName":42},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[38],{"fileName":39,"oldFileName":39,"type":18,"file":19,"url":40},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 20