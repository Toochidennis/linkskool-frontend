F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fshell-daystar-women-in-power-training-wipt-program-2026-for-nigerians-career-opportunity\u002F6a353cb5d749c9.82590804_screenshot%202026-06-19%20132844.png","2026-06-19 13:57:25",{"id":105,"slug":106,"title":107,"images":108,"datePosted":112,"authorName":50},296,"mccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity-296","Mccall Macbain Scholarship 2027 In Canada: Fully Funded Opportunity",[109],{"fileName":110,"oldFileName":110,"type":18,"file":19,"url":111},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity\u002F6a35399f674831.63838755_screenshot 2026-06-19 132844.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity\u002F6a35399f674831.63838755_screenshot%202026-06-19%20132844.png","2026-06-19 13:44:15",1782337546794]