[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-lagos-business-school-young-talents-programme-2026-for-students-and-graduates-233":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},233,"lagos-business-school-young-talents-programme-2026-for-students-and-graduates-233","Lagos Business School Young Talents Programme 2026 For Students And Graduates","\u003Cp>Attention, young students and graduates! The Lagos Business School Young Talents Program is here again!\u003C\u002Fp>\u003Cp>Are you ready to be part of a generation of new leaders shaping Africa? Join the LBS Young Talents Program 2026 by the Pan African University in Lagos.\u003C\u002Fp>\u003Cp>\u003Cstrong>Lagos Business School Young Talents Program Abstract\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: Lagos Business School (Pan Atlantic University)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Ftrainings\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Trainings\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Career Development\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Leadership Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Business Mentorship\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Networking Opportunity\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: June 2, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Lagos Business School Young Talents Program Requirements\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To be eligible for the Lagos Business School Young Talents Program, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>have graduated with a First or Second Class Upper degree (or its equivalent)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>be under 30 years old at the time of application\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>be currently enrolled in or have completed a master’s degree (\u003Cstrong>optional\u003C\u002Fstrong>)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Note: Previous participants of the YTP are not eligible to apply\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Required Documents for LBS Young Talents Program 2026\u003C\u002Fp>\u003Cp>While applying for the LBS Young Talents Program 2026, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Complete Application Form\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Bachelor\u002F Postgraduate Certificate\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Personal Statement\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Updated CV\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>How To Apply for Lagos Business School Young Talents Program 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To apply for the Lagos Business School Young Talents Program, follow the instructions we have outlined below; \u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Read the information we have provided on this webpage and ensure your eligibility.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Click the button below to visit the program’s website.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Fill out the application form, attach the required documents, and submit by the deadline.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fevents.lbs.edu.ng\u002FYTP26\">https:\u002F\u002Fevents.lbs.edu.ng\u002FYTP26\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","LINKSKOOL",16,"published",0,"2026-05-1