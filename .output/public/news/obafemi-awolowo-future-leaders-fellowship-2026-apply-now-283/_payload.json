[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-obafemi-awolowo-future-leaders-fellowship-2026-apply-now-283":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},283,"obafemi-awolowo-future-leaders-fellowship-2026-apply-now-283","Obafemi Awolowo Future Leaders Fellowship 2026: Apply Now","\u003Cp>Obafemi Awolowo Future Leaders Fellowship is designed to nurture ethical and visionary young leaders, equipping them with values, discipline, and perspective required for impactful leadership.\u003C\u002Fp>\u003Cp>In this post, the full details of the eligibility, benefits, timeline, and application procedure will be provided.\u003C\u002Fp>\u003Cp>\u003Cstrong>Obafemi Awolowo Future Leaders Fellowship Abstract\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Obafemi Awolowo Foundation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Virtual\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Ftrainings\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Trainings\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Leadership Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Mentorship\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Ca class=\"google-anno\" href=\"https:\u002F\u002Fscholarsworld.ng\u002Fobafemi-awolowo-future-leaders-fellowship\u002F#\"> \u003Cu>Collaborative\u003C\u002Fu>\u003C\u002Fa> Learning\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Leadership Development\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: August 31, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Obafemi Awolowo Foundation Fellowship Program Details\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The Ọbafẹmi Awolọwọ Future Leaders Fellowship Programme is a highly selective, merit-based initiative inspired by the enduring legacy of Chief Ọbafẹmi Awolọwọ, SAN, GCFR (1909-1987). The programme is designed to nurture ethical and visionary young leaders aged 20–35 from Africa, the Caribbean, and the global diaspora, equipping them with the values, discipline, and perspective required for impactful leadership.\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>Obafemi Awolowo Future Leaders Fellowship Benefits\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The Obafemi Awolowo Future Leaders Fellowship offers;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Leadership development\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Personal effectiveness training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Mentorship\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Collaborative learning.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Obafemi Awolowo Foundation Leadership Fellowship Requirements\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To be eligible for the \u003Cstrong>Obafemi Awolowo Foundation Fellowship Program\u003C\u002Fstrong>, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Be between age 25-30\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be a citizen of Africa, the Caribbean, and the global diaspora.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have strong interest in leadership\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cul>\u003Cli>\u003Cp>Be visionary\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Show strong leadership potential, integrity, and service orientation\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be available for the full programme duration\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Obafemi Awolowo Foundation Fellowship Program 2026 Required Documents\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>While applying for the leadership fellowship Program 2026, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>A personal statement\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Two Referees\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003C\u002Fp>\u003Cp>\u003Cstrong>How To Apply for Obafemi Awolowo Future Leaders Fellowship\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To apply for the Obafemi Awolowo Future Leaders Fellowship 2026, follow the instructions we have outlined below; \u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Read the information we have provided on this webpage and ensure your eligibility\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Prepare the required documents\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Fill in your personal information including LinkedIn Account\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Ready to lead? Join a cohort of ethically grounded, visionary leaders across the continent and beyond.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Foaflf.obafemiawolowofoundation.com\u002F\">https:\u002F\u002Foaflf.obafemiawolowofoundation.com\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Linkskool",16,"published",0,"2026-06-08 11:31:00",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fobafemi-awolowo-future-leaders-fellowship-2026-apply-now\u002F6a2699e4cec3d2.18351235_screenshot 2026-06-08 111712.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fobafemi-awolowo-future-leaders-fellowship-2026-apply-now\u002F6a2699e4cec3d2.18351235_screenshot%202026-06-08%20111712.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted