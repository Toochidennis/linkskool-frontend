[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"news-detail-tgi-young-professionals-program-2026-employment-opportunity-offer-46":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},46,"tgi-young-professionals-program-2026-employment-opportunity-offer-46","Tgi Young Professionals Program 2026 | Employment Opportunity Offer","TGI Young Professionals Program Abstract\n\n    Host: Tropical General Investments Group\n    Location: Lagos, Nigeria\n    Category: Trainings\n    Benefits:\n        Trainings\n        Full Time Career opportunities\n        Networking\n        Leadership capacity building\n    Eligibility: Nigeria\n    Deadline: March, 2026\n\nJob Details\n\n    The YPP is part of our talent pipeline strategy, offering experienced candidates an opportunity to deepen their knowledge and build required competencies necessary for future managerial\u002Fleadership roles.\n    The Program is designed to be cross-functional &amp; cross-business rotation, experiential\u002Fpractical knowledge &amp; project activities, which would run for 6 months.\n\nTGI Young Professionals Program 2026 Benefits\n\nSuccessful applicants for the TGI Young Professionals Program 2026 will gain:\n\n    Full Time Job opportunities\n    Invaluable trainings\n    Leadership Development\n    Career Opportunity\n\n\nTGI Young Professionals Program Requirements\n\nTo be eligible for the TGI Young Professionals Program 2026, applicants must satisfy the following conditions:International scholarships\n\n    B.Sc\u002FHND in Engineering, Social Sciences, Agriculture, Sciences, or other disciplines relevant to the business\n    Minimum of 2 years’ relevant work experience\n    Professional certification (an added advantage)\n    Graduate degree (MSc\u002FMBA) from a reputable business school (an added advantage)\n    Completed NYSC\n\n    Maximum age of 27 years\n    CV must contain comprehensive and relevant information about the applicant\n\n\nTGI Young Professionals Program Required Documents\n\nWhile applying for the TGI Young Professionals Program, you will be required to submit the following documents;\n\n    Complete Application Form\n    Academic Transcripts\n    Bachelors\u002F Diploma Certificate (Masters)\n    CV\n    NYSC Certificate\n\nAPPLY HERE: https:\u002F\u002Ftgi.seamlesshiring.com\u002Fjob\u002Fview\u002F8548#\u002F","Ijeoma",16,"published",0,"2026-03-04 09:17:14",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ftgi-young-professionals-program-2026-employment-opportunity-offer\u002F69a7ea8a8fb8e7.95508409_screenshot 2026-03-04 090132.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ftgi-young-professionals-program-2026-employment-opportunity-offer\u002F69a7ea8a8fb8e7.95508409_screenshot%202026-03-04%20090132.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,58,67,76,85,94,102],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19","LINKSKOOL",{"id":