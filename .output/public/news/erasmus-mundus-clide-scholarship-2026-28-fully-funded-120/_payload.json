[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-erasmus-mundus-clide-scholarship-2026-28-fully-funded-120":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},120,"erasmus-mundus-clide-scholarship-2026-28-fully-funded-120","Erasmus Mundus Clide Scholarship 2026\u002F28 | Fully Funded","\u003Cp>Applications are now being accepted from all qualified and interested international students for the Erasmus Mundus CLIDE Scholarship 2026.\u003C\u002Fp>\u003Cp>Erasmus Mundus CLIDE Scholarship Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Scholarship Host: Erasmus Mundus\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Study Abroad: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Study Abroad\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: Poland, Spain, Austria &amp; Morocco\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fpostgraduate-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Postgraduate Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fmasters-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Masters Scholarships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>No tuition fees\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Monthly stipend of €1,400\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Comprehensive Insurance\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Travel Expenses\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: April 15, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Erasmus Mundus CLIDE Scholarship Benefits\u003C\u002Fp>\u003Cp>Erasmus Mundus CLIDE Scholarship offers:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>No tuition fees\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Monthly stipend of €1,400 for 24 months\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>The stipend is for living expenses such as accommodation, food, and travel.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Comprehensive insurance\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>50 places available across four editions\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Erasmus Mundus CLIDE Scholarship Requirements\u003C\u002Fp>\u003Cp>To be eligible for the Erasmus Mundus CLIDE Scholarship, applicants must satisfy the following conditions:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>\u003Cstrong>Academic Background\u003C\u002Fstrong>: Must hold a first degree (Bachelor’s) or be in the final year of such studies.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Language Proficiency\u003C\u002Fstrong>: Proof of English at a \u003Cstrong>B2 level\u003C\u002Fstrong> (e.g., TOEFL, IELTS).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Documentation\u003C\u002Fstrong>: Required documents typically include a CV, Transcript of Records, motivation statement, and a unique \u003Cstrong>“Video Business Card”\u003C\u002Fstrong> or pitch.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Erasmus Mundus CLIDE Scholarship Required Documents\u003C\u002Fp>\u003Cp>While applying for the Erasmus Mundus CLIDE Scholarship, you will be required to submit the following documents;\u003C\u002Fp>\u003Cp>\u003Cstrong>University admission help\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Online Application Form\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Motivation Letter\u003C\u002Fstrong> + CV (\u003Ca href=\"https:\u002F\u002Fopportunitiescorners.com\u002Feuropass-cv-format\u002F\">\u003Cstrong>EUROPASS format\u003C\u002Fstrong>\u003C\u002Fa> recommended)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>2 Recommendation Letters\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>1 Academic\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>1 Professional\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Bachelor’s Degree Diploma\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>English translation (if not in English)\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Transcript of Records\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>English translation (if needed)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cem>(For final-year students)\u003C\u002Fem>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Certificate of Enrolment\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Latest transcript\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Eligibility Statement\u003C\u002Fstrong> (confirms you can study a Master’s)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Proof of English Proficiency (B2 level)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Certificates\u002Fachievements\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Internship or work proof\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Research papers (if any)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Video Introduction (Video Business Card)\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fclide.umk.pl\u002Fpages\u002Fhome\u002F\">https:\u002F\u002Fclide.umk.pl\u002Fpages\u002Fhome\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","LINKSKOOL",16,"published",0,"2026-04-08 12:27:09",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ferasmus-mundus-clide-scholarship-2026-28-fully-funded\u002F69d63b8d6ce6b3.51376427_screenshot 2026-04-08 122235.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ferasmus-mundus-clide-scholarship-2026-28-fully-funded\u002F69d63b8d6ce6b3.51376427_screenshot%202026-04-08%20122235.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,37,47,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":9},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19",{"id":38,"slug":39,"title":40,"images":41,"datePosted":45,"authorName":46},304,"mexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity","Mexican Government Scholarship For Foreigners 2026: Fully Funded Opportunity",[42],{"fileName":43,"oldFileName":43,"type":18,"file":19,"url":44},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity\u002F6a3c32aaeb8a11.62235495_screenshot 2026-06-24 201924.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Fel