[{"data":1,"prerenderedAt":112},["ShallowReactive",2],{"news-detail-google-summer-of-code-gsoc-2026-for-students-worldwide-paid-opportunity-88":3},{"news":4,"more":28},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":27},88,"google-summer-of-code-gsoc-2026-for-students-worldwide-paid-opportunity-88","Google Summer Of Code (gsoc) 2026 For Students Worldwide: Paid Opportunity","\u003Cp>2025 Google Summer of Code Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Google\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002Ftrainings\">Trainings\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>$6,000 Stipend\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Mentorship\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Training\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Application Deadline: March 31st, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Click \u003Ca href=\"https:\u002F\u002Fchat.whatsapp.com\u002FDsmoCvAKwR4A45IW1BbpUA\">\u003Cstrong>HERE\u003C\u002Fstrong>\u003C\u002Fa> To receive more daily scholarship updates from Scholars World.\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>2026 Google Summer of Code Benefits\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>\u003Cstrong>Duration:\u003C\u002Fstrong> Accepted students spend the summer coding with guidance from a mentor (3 months).\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Stipend:\u003C\u002Fstrong> Successful student contributors receive a $6000 USD stipend, allowing them to concentrate on coding for three months.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Google Summer of Code Requirements\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>\u003Cstrong>Age:\u003C\u002Fstrong> Participants must be eighteen (18) years of age or older upon registration.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Enrollment:\u003C\u002Fstrong> Should be enrolled in or accepted into an accredited institution (college, university, master’s program, PhD program, or undergraduate program) as of the Acceptance Date.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Work Eligibility:\u003C\u002Fstrong> Participants must be eligible to work in their country of residence for the duration of the program.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>\u003Cstrong>Previous Participation:\u003C\u002Fstrong> Students who have participated in Google Summer of Code two (2) or more times previously are ineligible.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cul>\u003Cli>\u003Cp>A resident of a United States embargoed country.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Ordinarily resident in a United States embargoed country.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Otherwise prohibited by applicable export controls and sanctions programs.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>An employee (including intern), contractor, officer, or director of Google or its affiliates, or an Organization or any of its affiliates.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>An immediate family member or household member of the individuals listed above.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Fsummerofcode.withgoogle.com\u002F\">https:\u002F\u002Fsummerofcode.withgoogle.com\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","LinkSkool",16,"published",0,"2026-03-21 12:54:53",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fgoogle-summer-of-code-gsoc-2026-for-students-worldwide-paid-opportunity\u002F6