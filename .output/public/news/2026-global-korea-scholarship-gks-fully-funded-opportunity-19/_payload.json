[{"data":1,"prerenderedAt":113},["ShallowReactive",2],{"news-detail-2026-global-korea-scholarship-gks-fully-funded-opportunity-19":3},{"news":4,"more":29},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":28},19,"2026-global-korea-scholarship-gks-fully-funded-opportunity-19","2026 Global Korea Scholarship (gks): Fully Funded Opportunity","The Korean Government presents an exceptional opportunity for prospective students from developing nations across the globe to study in the technologically and economically advanced country. \n\nThe Korea Government Scholarship includes comprehensive scholarships covering tuition, airfare, stipends, medical insurance, and more.\n\nBenefits: Full Scholarship\n\n    Tuition\n    Accommodation\n    900,000 KRW Monthly Stipends\n    Visa + Airfare Ticket\n    Medical Insurance\n\nEligibility: Developing Countries\nDeadline: March, 2026 \n\n\nGKS Undergraduate Scholarship Requirements 2026\n\nTo be eligible for the GKS Undergraduate Scholarship, applicants must meet the following criteria:\n\nCitizenship:\n\n    Candidates and their parents must possess non-Korean citizenship.\n\nAge:\n\n    KGSP-Undergraduates: Under 25\n\nHealth:\n\n    Candidates must be in sound physical and mental health to undertake their studies in Korea.\n\nDegree Requirements:\n\n    KGSP-Undergraduates: Applicants must have a High school diploma\n\nGrades:\n\n    The cumulative grade point average (CGPA) should be 80% or higher; alternatively,\n    The CGPA should be 2.64\u002F4.0, 2.80\u002F4.3, 2.91\u002F4.5, or 3.23\u002F5.0 or higher, or be in the top 20% of their class.\n\nApply here: https:\u002F\u002Fwww.studyinkorea.go.kr\u002Fko\u002Fplan\u002Fscholarship.do","Ijeoma",16,"published",0,"2026-02-18 09:22:06",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20}