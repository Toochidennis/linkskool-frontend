,[81],{"fileName":82,"oldFileName":82,"type":18,"file":19,"url":83},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fabdulkabir-aliu-foundation-aaf-integral-university-india-scholarship-2026-fully-funded\u002F6a3564e6085b90.12171095_screenshot 2026-06-19 163905.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fabdulkabir-aliu-foundation-aaf-integral-university-india-scholarship-2026-fully-funded\u002F6a3564e6085b90.12171095_screenshot%202026-06-19%20163905.png","2026-06-19 16:48:54",{"id":86,"slug":87,"title":61,"images":88,"datePosted":92,"authorName":57},297,"shell-daystar-women-in-power-training-wipt-program-2026-for-nigerians-career-opportunity-297",[89],{"fileName":90,"oldFileName":90,"type":18,"file":19,"url":91},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fshell-daystar-women-in-power-training-wipt-program-2026-for-nigerians-career-opportunity\u002F6a353cb5d749c9.82590804_screenshot 2026-06-19 132844.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fshell-daystar-women-in-power-training-wipt-program-2026-for-nigerians-career-opportunity\u002F6a353cb5d749c9.82590804_screenshot%202026-06-19%20132844.png","2026-06-19 13:57:25",{"id":94,"slug":95,"title":96,"images":97,"datePosted":101,"authorName":47},296,"mccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity-296","Mccall Macbain Scholarship 2027 In Canada: Fully Funded Opportunity",[98],{"fileName":99,"oldFileName":99,"type":18,"file":19,"url":100},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity\u002F6a35399f674831.63838755_screenshot 2026-06-19 132844.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmccall-macbain-scholarship-2027-in-canada-fully-funded-opportunity\u002F6a35399f674831.63838755_screenshot%202026-06-19%20132844.png","2026-06-19 13:44:15",{"id":103,"slug":104,"title":32,"images":105,"datePosted":109,"authorName":57},295,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity-295",[106],{"fileName":107,"oldFileName":107,"type":18,"file":19,"url":108},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a32ac1a0044e3.66262713_screenshot 2026-06-17 151101.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a32ac1a0044e3.66262713_screenshot%202026-06-17%20151101.png","2026-06-17 15:15:54",1782337545776]