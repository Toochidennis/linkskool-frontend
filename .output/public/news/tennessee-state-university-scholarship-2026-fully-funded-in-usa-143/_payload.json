[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-tennessee-state-university-scholarship-2026-fully-funded-in-usa-143":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},143,"tennessee-state-university-scholarship-2026-fully-funded-in-usa-143","Tennessee State University Scholarship 2026 | Fully Funded In Usa","\u003Cp>Applications are now being accepted from all qualified and interested international students for the 2026 Tennessee State University Scholarship.\u003C\u002Fp>\u003Cp>\u003Cstrong>Tennessee State University Scholarship Abstract\u003C\u002Fstrong>\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Tennessee State University\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Study Abroad: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarship\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Study Abroad\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarship\u002Fscholarships-in-usa\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Study-In-USA\u003C\u002Fa>\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Location: United States\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fpostgraduate-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Postgraduate Scholarships\u003C\u002Fa> || \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fscholarships\u002Fmasters-scholarships\u002F?utm_source=Google&amp;utm_medium=Catergory&amp;utm_campaign=Email+Campaign\">Masters Scholarships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits: Full Scholarship\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Tuition\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Health Insurance\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Monthly living stipends.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: All Countries\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: Not Specified\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Tennessee State University Scholarship Details\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>The Regenerative Soil Health Laboratory in the Department of Environmental Science at Tennessee State University invites applications for a fully funded M.S. graduate research assistantship in Soil Health and Regenerative Agriculture under the supervision of Sougata Bardhan.\u003C\u002Fp>\u003Cp>\u003Cstrong>Scholars World community\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>Students will engage in interdisciplinary research related to Soil health assessment and indicators, Soil–plant–microbe interactions, Biochar and organic amendments, Cover cropping practices, Agroforestry farming systems, Soil micronutrients, food quality, human health.\u003C\u002Fp>\u003Cp>Field research will be conducted in collaboration with farmers, extension specialists, and partner institutions across the southeastern United States.\u003C\u002Fp>\u003Cp>\u003Cstrong>Tennessee State University Scholarship 2026 Benefits\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>Tennessee State University Scholarship 2026 offers:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Full Scholarship\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Graduate stipend\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Research support\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Opportunities for conference travel and professional development\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Tennessee State University Scholarship 2026 Requirements\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To be eligible for the Tennessee State University Scholarship 2026, applicants must satisfy the following conditions\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>B.S. degree in Soil Science, Environmental Science, Agronomy, Ecology, Agriculture, or related fields\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Interest in field and laboratory research\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Strong motivation to work in interdisciplinary agricultural systems research\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Experience with soil sampling, lab analysis, or agricultural field work (preferred but not required)\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>Tennessee State University Scholarship Required Documents\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>While applying for the 2026 Tennessee State University Scholarship, you will be required to submit the following documents;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp> CV or Resume\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Statement of research interests (1 page)\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Unofficial transcripts\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Contact information for two references\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Cstrong>How To Apply for Tennessee State University Scholarship 2026\u003C\u002Fstrong>\u003C\u002Fp>\u003Cp>To apply for the Tennessee State University Scholarship 2026, follow the instructions we have outlined below; \u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Read the information we have provided on this webpage and ensure your eligibility\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Prepare all required documents\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Email it to Dr. Sougata Bardhan via his email\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>\u003Ca href=\"https:\u002F\u002Ftnstate.edu\u002F\">APPLY HERE: https:\u002F\u002Fsbardha1@tnstate.edu\u002F\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","linkskool",16,"published",0,"2026-04-15 16:38:32",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ftennessee-state-university-scholarship-2026-fully-funded-in-usa\u002F69dfb0f83a7e24.97132355_screenshot 2026-04-15 162951.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Ftennessee-state-university-scholarship-2026-fully-funded-in-usa\u002F69dfb0f83a7e24.97132355_screenshot%202026-04-15%20162951.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,47,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19","LINKSKOOL",{"id":39,"slug":40,"title":41,"images":42,"datePosted":46,"authorName":9},304,"mexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity","Mexican Government Scholarship For Foreigners 2026: Fully Funded Opportunity",[43],{"fileName":44,"oldFileName":44,"type":18,"file":19,"url":45},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fmexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity\u002F6a3c32aaeb8a11.62235495_screenshot 2026-06-24 201924.p