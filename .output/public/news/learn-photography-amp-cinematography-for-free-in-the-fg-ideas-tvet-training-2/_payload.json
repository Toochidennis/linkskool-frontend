[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"news-detail-learn-photography-amp-cinematography-for-free-in-the-fg-ideas-tvet-training-2":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":21,"updatedAt":22,"categories":23,"readTime":5},2,"learn-photography-amp-cinematography-for-free-in-the-fg-ideas-tvet-training-2","Learn Photography &amp; Cinematography For Free In The Fg Ideas Tvet Training","TVET (Technical and Vocational Education and Training) is a federal Government skills-based training program that focuses on practical learning to help individuals gain job-ready and self-employment skills.\n\nAs part of this TVET program,  a cinematography training is being offered in collaboration with Digital Dreams for individuals who are interested in film and video production.\n\n👉Register your interest here:\nhttps:\u002F\u002Fforms.gle\u002FPwDtRoSNKVRm33im8\n\nThe training is open to beginners and aspiring creatives. No prior experience is required, only interest, commitment, and willingness to learn.\n\nParticipants will receive hands-on training in camera handling, video shooting, basic lighting, and storytelling for film and digital content.\n\n*BENEFITS OF THE TRAINING*\n* Practical, industry-focused skills\n* Internship placement after the    training\n* National Skills Qualification (NSQ) Certification upon successful completion\n* Improved opportunities for employment and self-employment.\n\n*REQUIREMENTS*\n* Applicants must:\n* Be Nigerian citizens\n* Be 18 years and above (not more than 35 years)\n* Have a valid National Identification Number (NIN)\n* Have a Bank Verification Number (BVN)\n* (Name on NIN and BVN must match)\n* Have a commercial bank account with BVN\n* (FinTech\u002FMicrofinance banks are not accepted)\n* Have a valid email address\n* Have an active mobile phone number\n* Possess a minimum of Basic Education \u002F First School Leaving Certificate (FSLC)\n* (Non-formal education certificates are also accepted)\n\n\nIf you are interested in film, video, media, or content creation, this is a good opportunity to gain useful skills.\n\n 👉Register your interest here:\nhttps:\u002F\u002Fforms.gle\u002FPwDtRoSNKVRm33im8\n\n Limited slots available. Apply early.","Digital Dreams",11,"published",0,"2026-01-07 19:36:32",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002F695ea7b0ad02e2.56379684_chatgpt image jan 7, 2026, 12_01_17 pm.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002F695ea7b0ad02e2.56379684_chatgpt%20image%20jan%207,%202026,%2012_01_17%20pm.png","2026-01-07 13:36:32","2026-06-24 11:55:43",[24],{"id":5,"name":25,"createdAt":26},"Opportunities","2026-01-07 13:35:07",[28,38,48,58,67,76,85,94,102],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19","LINKSKOOL",{"id":39,"slug":40,"title":41,"images":42,"datePosted":46,"authorName":47},304,"mexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity","Mexican Government Scholarship For Foreigners 2026: Fully Funded Opportunity",[43],{"fileName":44,"oldFileName":44,"type":18,"file":19,"url":45},"assets\u0