[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"news-detail-goldsmiths-university-of-london-scholarship-2026-for-undergraduates-amp-postgraduates-fully-funded--51":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},51,"goldsmiths-university-of-london-scholarship-2026-for-undergraduates-amp-postgraduates-fully-funded--51","Goldsmiths University Of London Scholarship 2026 For Undergraduates &amp; Postgraduates (fully Funded)","It’s time to talk about the Goldsmiths University of London Scholarship UK.\n\nApplications for the 2026 Goldsmiths University of London Scholarship have commenced for interested and qualified candidates.\n\n\nGoldsmiths University of London Scholarship 2025 Abstract\n\n    Scholarship Host: Goldsmiths University of London \n    Study Abroad: Study Abroad || Study-In-UK \n    Location: United Kingdom\n    Category: Scholarships || Undergraduate Scholarships ||  Postgraduate Scholarships || Masters Scholarships \n    Benefits: Full Scholarship\n        Tuition\n        Accommodation\n        £8,825 Living Stipends\n    Eligibility: All Countries\n    Deadline: May 25, 2026\n\n\nGoldsmiths University of London Scholarship UK 2026 Benefits\n\nSuccessful applicants will receive £8,825 allowance, a full tuition fee waiver for each year of study, and an accommodation fee for a single study bedroom in Goldsmiths halls of residence (up to £200 per week).\n\n\nGoldsmiths University of London Scholarship 2026 Requirements\n\nTo be eligible for the undergraduate and postgraduate Goldsmiths University of London Scholarship 2026, applicants must satisfy the following conditions:Masters scholarships\n\n    Have refugee status in the UK, or have an active application for asylum in the UK (you will be required to provide documentation to demonstrate your status). Supporting documents should be uploaded to your MyGoldsmiths account.\n    Be holding an offer of study on an undergraduate or taught postgraduate degree at Goldsmiths.\n    You must be eligible to study in the UK. If you are on Immigration Bail, this must not have a condition prohibiting you from studying.\n\nRequired Documents for Goldsmiths University of London Scholarship UK 2026\n\nWhile applying for the 2026 Goldsmiths University of London Scholarship UK, you will be required to submit the following documents;Student financial aid\n\n    Complete Application Form\n    Academic Transcripts\n    Bachelors\u002F Diploma Certificate (Masters)\n    Personal Statement\n    Curriculum Vitae\n    Recommendation Letters\n    Proof of English Language Proficiency","Ijeoma",16,"published",0,"2026-03-04 10:33:26",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fgoldsmiths-university-of-london-scholarship-2026-for-undergraduates-amp-postgraduates-fully-funded\u002F69a7fc66c751a8.19923842_screenshot 2026-03-04 102838.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fgoldsmiths-university-of-london-scholarship-2026-for-undergraduates-amp-postgraduates-fully-funded\u002F69a7fc66c751a8.19923842_screenshot%202026-03-04%20102838.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,58,67,76,85,94,102],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-