[{"data":1,"prerenderedAt":110},["ShallowReactive",2],{"news-detail-sahara-group-graduate-trainee-2026-for-young-nigerians-apply-now-84":3},{"news":4,"more":27},{"id":5,"slug":6,"title":7,"content":8,"authorName":9,"authorId":10,"status":11,"recommended":12,"datePosted":13,"deadline":14,"images":15,"notifiedAt":14,"notifiedBy":14,"createdAt":13,"updatedAt":21,"categories":22,"readTime":24},84,"sahara-group-graduate-trainee-2026-for-young-nigerians-apply-now-84","Sahara Group Graduate Trainee 2026 For Young Nigerians: Apply Now","\u003Cp>Sahara Group Graduate Trainee Program Abstract\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Host: Sahara Energy\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Category: \u003Ca href=\"https:\u002F\u002Fscholarsworld.ng\u002Fcategory\u002Fscholarships-and-opportunities\u002Finternships\">Internships\u003C\u002Fa> \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Benefits:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Competitive Salary\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Employment\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Training\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Networking\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003C\u002Fli>\u003Cli>\u003Cp>Eligibility: Nigeria\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Deadline: December 31, 2026\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Sahara Group Graduate  Business Analyst Program (GBAP) Details\u003C\u002Fp>\u003Cp>The Sahara Group Graduate  Business Analyst Program (GBAP) is designed for exceptional young talents with a global mindset.\u003C\u002Fp>\u003Cp>\u003Cstrong>The Sahara Graduate Business Analyst Program\u003C\u002Fstrong> is more than a career launchpad; it is your fast track to greatness. Sahara Group offers the opportunity to learn, grow, lead, and make an impact across disciplines and career stages.\u003C\u002Fp>\u003Cp>You will be equipped with the skills, exposure, and real-world experience to thrive in the fast-moving industry through a combination of on-the-job training, as well as structured learning and development programs.\u003C\u002Fp>\u003Cp>\u003C\u002Fp>\u003Cp>Sahara Group Graduate  Business Analyst Program (GBAP) Requirements\u003C\u002Fp>\u003Cp>To be eligible for the Sahara Group Graduate Management Trainee Program, applicants must:\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>Possess a bachelor’s degree with a minimum of 2:1 in Business Administration, Finance , Economics, Engineering or a related field within Social or Management Sciences.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have between 0- 2 years of post-graduate formal working experience\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Have completed the NYSC Program.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>A master’s degree from a recognised university and professional qualifications will be a plus for accelerated growth.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Be Fluent in English. \u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Demonstrating proficiency in the French Language is an advantage.\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>Sahara Group Graduate Trainee Salary\u003C\u002Fp>\u003Cp>The Sahara Group Graduate Trainee Salary is estimated to be between ₦1.9m to ₦2.5m annually for fresh graduates.\u003C\u002Fp>\u003Cp>Required Documents for Sahara Group Graduate  Business Analyst Program (GBAP)\u003C\u002Fp>\u003Cp>You will be submitting the following while applying for the Sahara Graduate Trainee Program;\u003C\u002Fp>\u003Cul>\u003Cli>\u003Cp>\u003Cstrong>A completed\u003C\u002Fstrong> online application—all applicable sections must be filled out, including contact information, financial information, personal details and responses to essay questions.\u003C\u002Fp>\u003C\u002Fli>\u003Cli>\u003Cp>Curriculum Vitae\u003C\u002Fp>\u003C\u002Fli>\u003C\u002Ful>\u003Cp>APPLY HERE: \u003Ca href=\"https:\u002F\u002Ffa-eugs-saasfaprod1.fa.ocs.oraclecloud.com\u002FhcmUI\u002FCandidateExperience\u002Fen\u002Fsites\u002FCX_2002\u002Fjob\u002F525\">https:\u002F\u002Ffa-eugs-saasfaprod1.fa.ocs.oraclecloud.com\u002FhcmUI\u002FCandidateExperience\u002Fen\u002Fsites\u002FCX_2002\u002Fjob\u002F525\u003C\u002Fa>\u003C\u002Fp>\u003Cp>\u003C\u002Fp>","Linkskool",16,"published",0,"2026-03-21 12:31:26",null,[16],{"fileName":17,"oldFileName":17,"type":18,"file":19,"url":20},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fsahara-group-graduate-trainee-2026-for-young-nigerians-apply-now\u002F69be818e865015.47728232_screenshot 2026-03-21 121806.png","image","","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fsahara-group-graduate-trainee-2026-for-young-nigerians-apply-now\u002F69be818e865015.47728232_screenshot%202026-03-21%20121806.png","2026-06-24 11:55:43",[23],{"id":24,"name":25,"createdAt":26},2,"Opportunities","2026-01-07 13:35:07",[28,38,48,57,66,75,84,93,101],{"id":29,"slug":30,"title":31,"images":32,"datePosted":36,"authorName":37},305,"dartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity","Dartmouth College Kings Scholarship Usa 2026: Fully Funded Opportunity",[33],{"fileName":34,"oldFileName":34,"type":18,"file":19,"url":35},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot 2026-06-24 204255.png","https:\u002F\u002Flinkskool.com\u002Fassets\u002Felearning\u002Flrm\u002Fexplore\u002Fnews\u002Fdartmouth-college-kings-scholarship-usa-2026-fully-funded-opportunity\u002F6a3c3537be16a2.95289717_screenshot%202026-06-24%20204255.png","2026-06-24 20:51:19","LINKSKOOL",{"id":39,"slug":40,"title":41,"images":42,"datePosted":46,"authorName":47},304,"mexican-government-scholarship-for-foreigners-2026-fully-funded-opportunity","Mexican Government Scholarship For Foreigners 2026: Fully Funded Opportunity",[43],{"fileName":44,"oldFileName":44,"type":18,"file":19,"url":45},"assets\u002Felearning\u002Flrm\u002Fexplore\u002Fnew